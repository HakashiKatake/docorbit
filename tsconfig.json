{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noCheck": true,
    "noEmitOnError": false
  },
  "include": ["apps/**/*", "packages/**/*", "bin/**/*"],
  "exclude": ["node_modules", "dist", "tests", "eval-results"]
}
